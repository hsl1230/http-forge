# Example environment variables for HTTP Forge extension
# Copy to .env or set in your environment when developing

# Enable/disable embedded MCP server
HTTP_FORGE_MCP_AUTO_START=false

# URL for an external MCP server (if not using embedded)
HTTP_FORGE_MCP_URL=http://localhost:3100

# Logging level (debug/info/warn/error)
HTTP_FORGE_LOG_LEVEL=debug

# API keys or tokens used by the extension (do not commit real secrets)
HTTP_FORGE_OAUTH_CLIENT_ID=
HTTP_FORGE_OAUTH_CLIENT_SECRET=
